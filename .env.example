# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# Google Gemini (AI search, assistant, profile organizer) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-2

# Supabase (MasterClassMap project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared code classmates enter to join (case-insensitive)
COHORT_ACCESS_CODE=EXEC-FALL26
